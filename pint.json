{
    "preset": "laravel",
    "rules": {
        "declare_strict_types": true,
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "no_unused_imports": true,
        "single_line_after_imports": true,
        "blank_line_after_namespace": true,
        "array_syntax": {
            "syntax": "short"
        },
        "concat_space": {
            "spacing": "none"
        }
    }
}
